# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGODB_DB=brainbrand
JWT_SECRET=use-a-long-random-string
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GOOGLE_CLIENT_ID=
PORT=3000
NODE_ENV=development
